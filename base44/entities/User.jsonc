{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "User role: admin (full access incl. user management), pm (project manager, manage data), trade (subcontractor, scoped to own company), viewer (read-only)",
      "enum": [
        "admin",
        "pm",
        "trade",
        "viewer"
      ],
      "default": "viewer"
    },
    "company_id": {
      "type": "string",
      "description": "The company this user belongs to (used for visible_to scoping)"
    }
  },
  "required": [
    "role"
  ]
}