{
  "name": "Document",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "discipline": {
      "type": "string"
    },
    "building": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "floor": {
      "type": "string"
    },
    "drawing_no": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "upload_filename": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "uploaded_by_company": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string"
    },
    "original_id": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string"
    },
    "deleted_by": {
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "trade"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}