{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "drawing_set": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "member_company_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounts_email": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}