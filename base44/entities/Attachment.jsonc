{
  "name": "Attachment",
  "type": "object",
  "properties": {
    "visi_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "step_label": {
      "type": "string"
    },
    "requirement_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "thumb_uri": {
      "type": "string"
    },
    "original_filename": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_company": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "discipline": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "storage_path": {
      "type": "string"
    },
    "original_id": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string"
    },
    "deleted_by": {
      "type": "string"
    }
  },
  "required": [
    "visi_id",
    "file_uri"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        }
      ]
    }
  }
}