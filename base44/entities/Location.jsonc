{
  "name": "Location",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Building",
        "Level",
        "Zone",
        "Unit",
        "Room"
      ]
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "na"
      ],
      "default": "active"
    },
    "room_no": {
      "type": "string"
    },
    "apt_number": {
      "type": "string"
    },
    "apt_type": {
      "type": "string"
    },
    "bed_count": {
      "type": "number"
    },
    "finish": {
      "type": "string"
    },
    "mirrored": {
      "type": "boolean"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string"
    },
    "deleted_by": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "name",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}